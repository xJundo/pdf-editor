# Copy to .env (or set in the Coolify UI) and fill in real values.

# Postgres password used by the db service and injected into DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=generate-a-long-random-string
# Public URL of the app (the Coolify domain in production)
BETTER_AUTH_URL=http://localhost:3000

# Max PDF upload size in MB (optional, default 50)
# MAX_UPLOAD_MB=50

# Local development only (npm run dev outside Docker):
# DATABASE_URL=postgres://pdfeditor:pdfeditor@localhost:5432/pdfeditor
# PDF_SERVICE_URL=http://localhost:8000
